# Copiá este archivo como .env.local y completá los valores.
# NUNCA subas .env.local a GitHub.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-publica-anon

# Dirección pública de la app (en tu compu: http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Etapa 2 (SOLO SERVIDOR, nunca con NEXT_PUBLIC_): Anthropic → console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...
# Opcional: fuerza un modelo para TODOS los usuarios (si no, cada uno elige en Configuración)
# CLAUDE_MODEL=claude-opus-5-5
# Opcional: análisis por usuario cada 24 h (controla costos)
# LIMITE_GENERACIONES_DIA=20
